<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gadeia's Cursos - @ViewBag.Titulo</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        /* Mantemos apenas as configurações globais indispensáveis */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F4F6;
        }

        /* Efeito visual agradável ao passar o mouse nos links do menu */
        .nav-link {
            font-weight: 500;
            color: #4B5563;
            transition: color 0.2s ease-in-out;
        }

        .nav-link:hover {
            color: #5a38f5; /* Aquele roxo/azul do sistema */
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg bg-white shadow-sm py-3">
            <div class="container-fluid px-md-4">
                
                <a class="navbar-brand d-flex align-items-center gap-2 text-dark text-decoration-none" asp-controller="Home" asp-action="Index">
                    <div class="d-flex align-items-center justify-content-center rounded text-white" 
                         style="width: 38px; height: 38px; background-color: #5a38f5;">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </div>
                    <span class="fw-bold" style="font-size: 1.3rem; letter-spacing: -0.5px;">Gadeia's Cursos</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Alternar navegação">
                    <i class="bi bi-list fs-1 text-muted"></i>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="menuPrincipal">
                    <ul class="navbar-nav gap-2 mt-3 mt-lg-0 text-center text-lg-start">
                       
                        @if(User.Identity?.IsAuthenticated == true){
                            <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Aluno" asp-action="Listar">Alunos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Tutor" asp-action="Listar">Tutores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Curso" asp-action="Listar">Cursos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Turma" asp-action="Listar">Turmas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Categoria" asp-action="Listar">Categorias</a>
                        </li>

                        <li class="nav-item">
                            <div class="dropdown ms-3">
                        <button class="btn btn-outline-primary rounded-pill btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-controller="Autenticacao" asp-action="Sair" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger">Sair</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                        </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>
    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container text-center">
            <span class="text-muted d-block d-md-inline" style="font-size: 0.85rem;">
                Desenvolvido pelos <span class="fw-bold text-dark">Gadeias!</span> Kovalski e VictorJer &copy; 2026
            </span>
            <span class="d-none d-md-inline text-muted mx-2">|</span>
            <span class="text-muted d-block d-md-inline mt-1 mt-md-0" style="font-size: 0.85rem;">
                <i class="bi bi-laptop me-1" style="color: #5a38f5;"></i> Academia Do Programador
            </span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js" 
            integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" 
            integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>

</body>

</html>