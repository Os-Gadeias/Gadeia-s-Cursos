@{
    Layout = "_Layout";
}

<style>
    /* Mantivemos apenas a animação de hover (flutuar o card), pois não há utilitário nativo no Bootstrap para isso */
    .hover-scale {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s;
    }

    .hover-scale:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
    }

    .btn-arrow-hover {
        transition: all 0.2s;
    }

    .btn-arrow-hover:hover {
        background-color: #5a38f5 !important;
        color: #fff !important;
    }
</style>

<div class="container-fluid py-2 d-flex flex-column align-items-center min-vh-100" style="background-color: #f8f9fc;">

    <div class="text-center mb-5 mt-4" style="max-width: 600px;">
        <span class="d-block mb-2 fw-semibold text-muted" style="font-size: 0.95rem;">Bem-vindo(a) de volta! 👋</span>
        <h1 class="fw-bold text-dark mb-3" style="font-size: 2.5rem; letter-spacing: -1px;">Painel de Gestão</h1>
        <p class="text-secondary" style="font-size: 1rem; line-height: 1.5;">
            Gerencie alunos, tutores, cursos, turmas e categorias de forma rápida e intuitiva.
        </p>
    </div>

    <div class="row justify-content-center g-4 w-100" style="max-width: 1000px;">

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 hover-scale bg-white">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-center rounded-3 mb-4"
                         style="width: 55px; height: 55px; background-color: #f2efff; color: #5a38f5;">
                        <i class="bi bi-person-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Alunos</h5>
                    <p class="text-muted mb-4" style="font-size: 0.9rem;">Visualize e gerencie os alunos cadastrados no
                        sistema.</p>

                        <a asp-controller="Aluno" asp-action="Listar"
                           class="btn rounded-circle d-flex align-items-center justify-content-center mt-auto align-self-end btn-arrow-hover"
                           style="width: 40px; height: 40px; background-color: #f4f0ff; color: #5a38f5;">
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-3 hover-scale bg-white">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-center rounded-3 mb-4"
                             style="width: 55px; height: 55px; background-color: #e6f2ff; color: #007bff;">
                            <i class="bi bi-person-workspace fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Tutores</h5>
                        <p class="text-muted mb-4" style="font-size: 0.9rem;">Visualize e gerencie o quadro de Tutores.
                        </p>

                        <a asp-controller="Tutor" asp-action="Listar"
                           class="btn rounded-circle d-flex align-items-center justify-content-center mt-auto align-self-end btn-arrow-hover"
                           style="width: 40px; height: 40px; background-color: #f4f0ff; color: #5a38f5;">
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-3 hover-scale bg-white">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-center rounded-3 mb-4"
                             style="width: 55px; height: 55px; background-color: #eafbf0; color: #28a745;">
                            <i class="bi bi-journal-bookmark-fill fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Cursos</h5>
                        <p class="text-muted mb-4" style="font-size: 0.9rem;">Gerencie os cursos disponíveis na instituição.
                        </p>

                        <a asp-controller="Curso" asp-action="Listar"
                           class="btn rounded-circle d-flex align-items-center justify-content-center mt-auto align-self-end btn-arrow-hover"
                           style="width: 40px; height: 40px; background-color: #f4f0ff; color: #5a38f5;">
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-3 hover-scale bg-white">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-center rounded-3 mb-4"
                             style="width: 55px; height: 55px; background-color: #fff6e5; color: #fd7e14;">
                            <span style="font-size: 1.5rem;">🏫</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Turmas</h5>
                        <p class="text-muted mb-4" style="font-size: 0.9rem;">Organize e gerencie as turmas e horários.</p>

                        <a asp-controller="Turma" asp-action="Listar"
                           class="btn rounded-circle d-flex align-items-center justify-content-center mt-auto align-self-end btn-arrow-hover"
                           style="width: 40px; height: 40px; background-color: #f4f0ff; color: #5a38f5;">
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-3 hover-scale bg-white">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-center rounded-3 mb-4"
                             style="width: 55px; height: 55px; background-color: #ffeef2; color: #e83e8c;">
                            <span style="font-size: 1.5rem;">🏷️</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Categorias</h5>
                        <p class="text-muted mb-4" style="font-size: 0.9rem;">Gerencie as categorias de cursos e conteúdos.
                        </p>

                        <a asp-controller="Categoria" asp-action="Listar"
                           class="btn rounded-circle d-flex align-items-center justify-content-center mt-auto align-self-end btn-arrow-hover"
                           style="width: 40px; height: 40px; background-color: #f4f0ff; color: #5a38f5;">
                            <i class="bi bi-arrow-right-short fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>