@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}
<style>
    /* Estilos customizados para chegar o mais perto possível da imagem */
    body {
        background-color: #f8f9fc;
        /* Fundo levemente cinza/azulado */
    }

    .dashboard-header-title {
        font-weight: 800;
        color: #1a1a2e;
        font-size: 2.5rem;
    }

    .dashboard-subtitle {
        color: #8c8c9e;
        font-size: 1rem;
    }

    .welcome-text {
        color: #6b6b7a;
        font-size: 0.9rem;
    }

    /* Estilização dos Cards */
    .custom-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s ease-in-out, box-shadow 0.2s;
    }

    .custom-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
    }

    .card-title {
        font-weight: 700;
        color: #1a1a2e;
        margin-top: 1rem;
        font-size: 1.1rem;
    }

    .card-text {
        color: #8c8c9e;
        font-size: 0.85rem;
        line-height: 1.4;
    }

    /* Ícones e seus fundos coloridos */
    .icon-wrapper {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.8rem;
        font-size: 1.5rem;
    }

    .bg-icon-alunos {
        background-color: #f2efff;
        color: #4e54c8;
    }

    .bg-icon-professores {
        background-color: #e6f2ff;
        color: #007bff;
    }

    .bg-icon-cursos {
        background-color: #eafbf0;
        color: #28a745;
    }

    .bg-icon-turmas {
        background-color: #fff6e5;
        color: #fd7e14;
    }

    .bg-icon-categorias {
        background-color: #ffeef2;
        color: #e83e8c;
    }

    /* Botão de seta (Ação) */
    .btn-arrow {
        background-color: #f4f0ff;
        color: #7b4dff;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background-color 0.2s;
    }

    .btn-arrow:hover {
        background-color: #7b4dff;
        color: #fff;
    }

    .btn-arrow i {
        font-size: 1.1rem;
    }
</style>

<div class="container-fluid py-2">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <div class="mb-5">
                <span class="welcome-text d-block mb-1">Bem-vindo(a) de volta! 👋</span>
                <h1 class="dashboard-header-title mb-2">Painel de Gestão</h1>
                <p class="dashboard-subtitle">Gerencie alunos, professores, cursos e muito mais.</p>
            </div>

            <div class="row g-4">

                <div class="col-12 col-md-4">
                    <div class="card custom-card h-100 p-3">
                        <div class="card-body d-flex flex-column">
                            <div class="icon-wrapper bg-icon-alunos mb-3">
                                <span class="bi bi-person-fill">🧑‍🎓</span>
                            </div>
                            <h5 class="icone">Alunos</h5>
                            <p class="card-text mb-4">Visualize e gerencie os alunos cadastrados.</p>

                            <a asp-controller="Aluno" asp-action="Listar" class="btn-arrow mt-auto align-self-end">
                                <span class="bi bi-arrow-right-short">⚙️</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card custom-card h-100 p-3">
                        <div class="card-body d-flex flex-column">
                            <div class="icon-wrapper bg-icon-professores mb-3">
                                <span class="bi bi-person-workspace">👨‍🏫</span>
                            </div>
                            <h5 class="icone">Professores</h5>
                            <p class="card-text mb-4">Visualize e gerencie os professores.</p>

                            <a asp-controller="Tutor" asp-action="Listar" class="btn-arrow mt-auto align-self-end">
                                <span class="bi bi-arrow-right-short">⚙️</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card custom-card h-100 p-3">
                        <div class="card-body d-flex flex-column">
                            <div class="icon-wrapper bg-icon-cursos mb-3">
                                <span class="bi bi-journal-bookmark-fill">📚</span>
                            </div>
                            <h5 class="icone">Cursos</h5>
                            <p class="card-text mb-4">Gerencie os cursos disponíveis na escola.</p>

                            <a asp-controller="Curso" asp-action="Listar" class="btn-arrow mt-auto align-self-end">
                                <span class="bi bi-arrow-right-short">⚙️</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="card custom-card h-100 p-3">
                        <div class="card-body d-flex flex-column">
                            <div class="icon-wrapper bg-icon-turmas mb-3">
                                <span class="icone">🏫</span>
                            </div>
                            <h5 class="card-title">Turmas</h5>
                            <p class="card-text mb-4">Organize e gerencie as turmas e horários.</p>

                            <a asp-controller="Turma" asp-action="Listar" class="btn-arrow mt-auto align-self-end">
                                <span class="bi bi-arrow-right-short">⚙️</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="card custom-card h-100 p-3">
                        <div class="card-body d-flex flex-column">
                            <div class="icon-wrapper bg-icon-categorias mb-3">
                                <span class="icone">🏷️</span>
                            </div>
                            <h5 class="card-title">Categorias</h5>
                            <p class="card-text mb-4">Gerencie as categorias de cursos e conteúdos.</p>

                            <a asp-controller="Categoria" asp-action="Listar" class="btn-arrow mt-auto align-self-end">
                                <span class="bi bi-arrow-right-short">⚙️</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 d-none d-lg-flex justify-content-center mt-5 mt-lg-0">
            <img src="~/images/professor-illustration.png" alt="Ilustração de um Professor" class="img-fluid"
                 style="max-height: 450px;" />
        </div>

    </div>
</div>
