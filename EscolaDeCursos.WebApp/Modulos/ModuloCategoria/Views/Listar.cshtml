@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Categorias";
}

@model List<ListarCategoriaViewModel>;

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2">
        <h2 class="fw-bold text-dark mb-0">Categorias</h2>
        <a class="btn fw-semibold text-white d-flex align-items-center gap-2 shadow-sm"
           style="background-color: #5a38f5; padding: 10px 20px; border-radius: 8px;" asp-action="Cadastrar">
            <i class="bi bi-plus-lg"></i> Nova Categoria
        </a>
    </div>

    @if (TempData["MensagemErro"] is string mensagemErro)
    {
        <div class="alert alert-danger border-0 border-start border-danger border-4 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @mensagemErro
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert bg-white border-0 shadow-sm rounded-4 p-5 text-center text-muted" role="alert">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            <h5 class="fw-semibold">Nenhuma categoria encontrada</h5>
            <p class="mb-0 small">Cadastre uma nova categoria para visualizá-la aqui.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
            @foreach (ListarCategoriaViewModel f in Model)
            {
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 rounded-4 p-2">
                        <div class="card-body d-flex flex-column">

                            <div class="rounded-circle d-flex align-items-center justify-content-center mb-3"
                                 style="width: 65px; height: 65px; background-color: @(f.Cor)1A; border: 1px solid @(f.Cor)33;">
                                <span style="font-size: 2rem;">@f.Icon</span>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-4" style="font-size: 1.15rem;">@f.Titulo</h5>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-1">
                                    <span class="text-muted d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                                        <i class="bi bi-hash"></i> ID
                                    </span>
                                    <span class="fw-semibold text-dark" style="font-size: 0.85rem;">
                                        @f.Id.ToString().Substring(0, 8)
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                                        <i class="bi bi-palette"></i> Cor
                                    </span>
                                    <span class="fw-semibold text-dark text-uppercase d-flex align-items-center gap-2"
                                          style="font-size: 0.85rem;">
                                        <span class="rounded-circle border"
                                              style="width: 12px; height: 12px; background-color: @f.Cor;"></span>
                                        @f.Cor
                                    </span>
                                </div>
                            </div>

                            <div class="mt-auto d-flex justify-content-end gap-3 pt-3 border-top">
                                <a asp-action="Editar" asp-route-id="@f.Id" class="text-decoration-none text-secondary"
                                   title="Editar" style="font-size: 1.1rem;">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Excluir" asp-route-id="@f.Id" class="text-decoration-none text-danger"
                                   title="Excluir" style="font-size: 1.1rem;">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>