@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Categoria";
}

@model CadastrarCategoriaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4 mt-3" style="min-width: 620px;" asp-action="Cadastrar"
      method="post">
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Titulo</label>
        <input asp-for="Titulo" type="text" class="form-control">
        <span asp-validation-for="Titulo" class="text-danger small fw-semibold"></span>
    </div>

    <div class="row align-items-center">

        <div class="col-auto d-flex align-items-center">
            <label asp-for="Cor" class="form-label me-2 mb-0">Cor</label>
            <input type="color" class="form-control form-control-color" asp-for="Cor""
                   title=" Escolha sua cor">
        </div>

        <div class="col-auto d-flex align-items-center">
            <label asp-for="Icon" class="form-label me-2 mb-0">Emoji</label>
            <input type="text" class="form-control" id="emojiInput" asp-for="Icon" placeholder="Ex: 👋" style="width: 50px;">
        </div>
    </div>
    
    <span asp-validation-for="Icon" class="text-danger small fw-semibold mt-2"></span>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>