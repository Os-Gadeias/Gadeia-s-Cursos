@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Turmas";
}

@model List<ListarTurmaViewModel>;

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2">
        <h2 class="fw-bold text-muted mb-0">Turmas</h2>
        <a class="btn fw-semibold text-white d-flex align-items-center gap-2 shadow-sm"
           style="background-color: #5a38f5; padding: 10px 20px; border-radius: 8px;" asp-action="Cadastrar">
            <i class="bi bi-plus-lg"></i> Novo Turma
        </a>
    </div>

    @if (TempData["MensagemErro"] is string mensagemErro)
    {
        <div class="alert alert-danger border-0 border-start border-danger border-4 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @mensagemErro
        </div>
    }
    @if (TempData["MensagemSucesso"] is string MensagemSucesso)
    {
        <div class="alert alert-primary border-0 border-start border-primary border-4 shadow-sm rounded-3 " role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @MensagemSucesso
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert bg-white border-0 shadow-sm rounded-4 p-5 text-center text-muted" role="alert">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            <h5 class="fw-semibold">Nenhuma Turma encontrada</h5>
            <p class="mb-0 small">Cadastre uma nova Turma para visualizá-la aqui.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (ListarTurmaViewModel c in Model)
            {
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 rounded-4 p-2">
                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title fw-bold text-dark mb-4" style="font-size: 1.5rem;">Turma: @c.Titulo</h5>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-1">
                                    <span class="text-muted d-flex align-items-center gap-2" style="font-size: 1.25rem;">
                                        <i class="bi bi-hash"></i> ID
                                    </span>
                                    <span class="fw-semibold text-muted" style="font-size: 1.25rem;">
                                        @c.Id.ToString().Substring(0, 8)
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted d-flex align-items-center gap-2" style="font-size: 1.25rem;">
                                        Capacidade Máxima
                                    </span>
                                    <span class=" text-muted text-uppercase d-flex align-items-center gap-2"
                                          style="font-size: 1.25rem;">
                                        @c.CapacidadeMaxima
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted d-flex align-items-center gap-2" style="font-size: 1.25rem;">
                                        Data de Início
                                    </span>
                                    <span class=" text-muted text-uppercase d-flex align-items-center gap-2"
                                          style="font-size: 1.25rem;">
                                        @c.DataInicio;
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted d-flex align-items-center gap-2" style="font-size: 1.25rem;">
                                        Data de Término
                                    </span>
                                    <span class=" text-muted text-uppercase d-flex align-items-center gap-2"
                                          style="font-size: 1.25rem;">
                                        @c.DataTermino;
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted d-flex align-items-center gap-2" style="font-size: 1.25rem;">
                                        Tutor
                                    </span>
                                    <span class=" text-muted text-uppercase d-flex align-items-center gap-2"
                                          style="font-size: 1.25rem;">
                                        @c.NomeTutor;
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted d-flex align-items-center gap-2" style="font-size: 1.25rem;">
                                        Curso
                                    </span>
                                    <span class=" text-muted text-uppercase d-flex align-items-center gap-2"
                                          style="font-size: 1.25rem;">
                                        @c.NomeCurso;
                                    </span>
                                </div>
                            </div>
                            <div class="mt-auto d-flex justify-content-end gap-3 pt-3 border-top">
                                <a asp-controller="Matricula" asp-action="Visualizar" asp-route-id="@c.Id" class="text-decoration-none text-primary"
                                   title="Visualizar" style="font-size: 1.1rem;">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Editar" asp-route-id="@c.Id" class="text-decoration-none text-secondary"
                                   title="Editar" style="font-size: 1.1rem;">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Excluir" asp-route-id="@c.Id" class="text-decoration-none text-danger"
                                   title="Excluir" style="font-size: 1.1rem;">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
