@{
    Layout = "_Layout";
    ViewBag.Nome = "Matricula de Aluno";

    List<SelectListItem> Alunos = ViewBag.Alunos;
}

@model CadastrarMatriculaViewModel;
<form class="card border-0 shadow-sm mx-auto rounded-4 p-4 mt-5 mx-auto" style="max-width: 650px;"
      asp-action="CadastrarMatricula" method="post">
    <div class="d-flex align-items-center mb-4 gap-3">
        <div class="d-flex justify-content-center align-items-center rounded-circle"
             style="width: 56px; height: 56px; background-color: #eeeaff; color: #5a38f5; font-size: 1.5rem;">
            <i class="bi bi-tags"></i>
        </div>
        <input type="hidden" asp-for="Id">
        <div>
            <h4 class="fw-bold mb-1 text-dark" style="font-size: 1.25rem;">Matricular Aluno</h4>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Selecione o aluno abaixo para matricular à Turma.</p>
        </div>
    </div>
    <hr class="text-secondary-subtle mb-4">
    <div class="row mb-2">
        <div class="row mb-2">
            <div class="mb-3">
                <label asp-for="IdAluno" class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Aluno</label>
                <div class="input-group">
                    <select asp-for="IdAluno" asp-items="Alunos" type="text"
                            class="form-control border-start-0 ps-1 shadow-none py-2">
                        <option class="form-control border-start-0 ps-1 shadow-none py-2" value="">Selecione um
                            Aluno...
                        </option>
                    </select>
                </div>
                <span asp-validation-for="IdAluno" class="text-danger small fw-semibold"></span>
            </div>
        </div>

        <hr class="text-secondary-subtle mt-2 mb-4">

        <div class="d-flex justify-content-end gap-3">
            <a class="btn bg-white border px-4 fw-semibold text-dark py-2"
               style="font-size: 0.9rem; border-color: #dee2e6;" asp-action="Listar">
                Cancelar
            </a>
            <button class="btn px-4 fw-semibold text-white d-flex align-items-center gap-2 py-2"
                    style="background-color: #5a38f5; font-size: 0.9rem;" type="submit">
                <i class="bi bi-plus-lg"></i> Matricular
            </button>
        </div>
    </div>
</div>
</form>
