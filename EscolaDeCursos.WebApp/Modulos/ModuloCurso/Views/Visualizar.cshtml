
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Visualização do Curso";
}

@model VisualizarTurmaEAulasViewModel

<div class="container py-5 d-flex justify-content-center">
    <div class="card border-0 shadow-sm rounded-4 w-100" style="max-width: 850px;">
        <div class="card-body p-4 p-md-5">

            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-4 mb-4">
                
                <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                     style="width: 75px; height: 75px; background-color: #f2efff; color: #5a38f5;">
                    <i class="bi bi-mortarboard fs-2"></i>
                </div>

                <div>
                    <h2 class="fw-bold text-dark mb-2" style="letter-spacing: -0.5px;">Curso: @Model.Nome</h2>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge rounded-pill px-3 py-2 fw-medium text-white" style="background-color: #5a38f5; font-size: 0.85rem;">
                            Nível de Dificuldade: @Model.Dificuldade
                        </span>
                        <span class="badge rounded-pill px-3 py-2 fw-medium text-dark border border-secondary-subtle" style="background-color: #f1f3f5; font-size: 0.85rem;">
                            Categoria: @Model.CategoriaNome
                        </span>
                    </div>
                </div>
            </div>

            <hr class="text-secondary-subtle my-4">

            <div class="d-flex align-items-center text-muted mb-4" style="font-size: 0.95rem;">
                <i class="bi bi-clock fs-5 me-2 text-secondary"></i>
                <span>Carga Horária: @Model.CargaHoraria</span>
            </div>

            <hr class="text-secondary-subtle my-4">

            <div class="mb-5">
                <h4 class="fw-bold text-dark d-flex align-items-center mb-4" style="font-size: 1.25rem;">
                    <i class="bi bi-journal-text me-2" style="color: #5a38f5;"></i> Lista de Aulas
                </h4>

                @if (Model.Aulas == null || !Model.Aulas.Any())
                {
                    <div class="alert bg-light border border-secondary-subtle text-center text-muted rounded-3 p-4">
                        <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                        Nenhuma aula cadastrada para este curso ainda.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var aula in Model.Aulas)
                        {
                            <div class="d-flex justify-content-between align-items-center border border-secondary-subtle rounded-3 p-3 bg-white hover-shadow-sm transition-all">
                                <span class="fw-semibold text-dark" style="font-size: 0.95rem;">
                                    Aula: @aula.Nome - Duração @aula.Duracao
                                </span>
                                
                                <div class="d-flex gap-2">
                                    <a asp-controller="Aula" asp-action="Editar" asp-route-id="@aula.Id" 
                                       class="btn btn-light border-secondary-subtle px-3 py-1 text-secondary" 
                                       data-bs-toggle="tooltip" data-bs-placement="top" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    
                                    <a asp-controller="Aula" asp-action="Excluir" asp-route-id="@aula.Id" 
                                       class="btn btn-outline-danger border-danger-subtle px-3 py-1" 
                                       data-bs-toggle="tooltip" data-bs-placement="top" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <hr class="text-secondary-subtle my-4">

            <div class="d-flex justify-content-end gap-3 mt-4">
                <a asp-action="Listar" class="btn border-secondary-subtle fw-semibold px-4 py-2 text-dark d-flex align-items-center gap-2" style="background-color: #f1f3f5;">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
                <a asp-action="CadastrarAula" asp-route-id="@Model.Id" class="btn fw-semibold px-4 py-2 text-white d-flex align-items-center gap-2 shadow-sm" style="background-color: #5a38f5;">
                    <i class="bi bi-plus-lg"></i> Cadastrar Aula
                </a>
            </div>
        </div>
    </div>
</div>