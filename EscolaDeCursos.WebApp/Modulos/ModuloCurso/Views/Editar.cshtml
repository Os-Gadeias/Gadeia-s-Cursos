@using EscolaDeCursos.Dominio.Modulos.ModuloCurso
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Curso";

    List<SelectListItem> Categorias = ViewBag.Categorias;
}

@model EditarCursoViewModel;
<form class="card border-0 shadow-sm mx-auto rounded-4 p-4 mt-5 mx-auto" style="max-width: 650px;" asp-action="Editar"
      method="post">
    <div class="d-flex align-items-center mb-4 gap-3">
        <div class="d-flex justify-content-center align-items-center rounded-circle"
             style="width: 56px; height: 56px; background-color: #eeeaff; color: #5a38f5; font-size: 1.5rem;">
            <i class="bi bi-tags"></i>
        </div>
        <div>
            <h4 class="fw-bold mb-1 text-dark" style="font-size: 1.25rem;">Edição Curso</h4>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Preencha os dados abaixo para Editar um novo
                Curso.</p>
            </div>
        </div>

        <hr class="text-secondary-subtle mb-4">

        <div class="mb-4">
            <label asp-for="Nome" class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Nome da
                Curso</label>
                <div class="input-group">
                    <input asp-for="Nome" type="text" class="form-control border-start-0 ps-1 shadow-none py-2"
                           placeholder="Digite o nome do Curso">
                </div>
                <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
            </div>

            <div class="row mb-2">
                <div class="col-md-6 mb-3">
                    <label asp-for="CargaHoraria" class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Carga Horária
                    </label>
                    <div class="input-group">
                        <input asp-for="CargaHoraria" type="number" min="0"
                               class="form-control border-start-0 ps-1 shadow-none py-2">
                    </div>
                    <span asp-validation-for="CargaHoraria" class="text-danger small fw-semibold mt-1 d-block"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Dificuldade" class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Nível de
                        Dificuldade</label>
                        <div class="input-group">
                            <select asp-for="Dificuldade" type="text" class="form-control border-start-0 ps-1 shadow-none py-2">
                                <option value="">Selecione uma Opção...</option>
                                <option value="@NivelDeDificildade.Inicial">Inicial</option>
                                <option value="@NivelDeDificildade.Intermediario">Intermediario</option>
                                <option value="@NivelDeDificildade.Avancado">Avançado</option>
                            </select>
                        </div>
                        <span asp-validation-for="Dificuldade" class="text-danger small fw-semibold mt-1 d-block"></span>
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="CategoriaId" class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Categoria</label>
                    <div class="input-group">
                        <select asp-for="CategoriaId" asp-items="Categorias" type="text"
                                class="form-control border-start-0 ps-1 shadow-none py-2">
                            <option class="form-control border-start-0 ps-1 shadow-none py-2" value="">Selecione uma Categoria...
                            </option>
                        </select>
                    </div>
                    <span asp-validation-for="CategoriaId" class="text-danger small fw-semibold"></span>
                </div>

                <hr class="text-secondary-subtle mt-2 mb-4">

                <div class="d-flex justify-content-end gap-3">
                    <a class="btn bg-white border px-4 fw-semibold text-dark py-2" style="font-size: 0.9rem; border-color: #dee2e6;"
                       asp-action="Listar">
                        Cancelar
                    </a>
                    <button class="btn px-4 fw-semibold text-white d-flex align-items-center gap-2 py-2"
                            style="background-color: #5a38f5; font-size: 0.9rem;" type="submit">
                        <i class="bi bi-plus-lg"></i> Editar Curso
                    </button>
                </div>
            </div>
        </div>
    </form>
